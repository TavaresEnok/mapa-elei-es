{
  "name": "mapa",
  "version": "3.0.0",
  "description": "Mapa de apuração eleitoral ao vivo (presidente, governador e senador; 5.570 municípios) com dados abertos do TSE e malhas do IBGE.",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "updater": "node src/updater/index.js",
    "updater:once": "node src/updater/index.js --once",
    "simular": "node src/updater/index.js --simular",
    "geo": "node scripts/build-geo.js",
    "pm2": "pm2 start ecosystem.config.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
